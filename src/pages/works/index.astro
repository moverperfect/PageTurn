---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  acceptCatalogSuggestion,
  CatalogConflictError,
  CatalogNotFoundError,
  CatalogValidationError,
  searchCatalog,
} from '../../lib/catalog';

if (!Astro.locals.session?.User) {
  return Astro.redirect('/login');
}

const query = Astro.url.searchParams.get('q') ?? '';
let acceptError = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const suggestion = JSON.parse((data.get('suggestion') as string) || '');
    const accepted = await acceptCatalogSuggestion({ suggestion }, env);
    return Astro.redirect(`/works/${accepted.work.id}`);
  } catch (error) {
    if (
      error instanceof CatalogValidationError ||
      error instanceof CatalogNotFoundError ||
      error instanceof CatalogConflictError
    ) {
      acceptError = error.message;
    } else {
      console.error('Error accepting catalog suggestion:', error);
      acceptError = 'Failed to accept that suggestion. Please try again.';
    }
  }
}

const { works, suggestions, providerError } = await searchCatalog(query, env);
---

<Layout title="Catalog | PageTurn">
  <div>
    <div class="flex justify-between items-center mb-6">
      <h1 class="mb-0">Catalog</h1>
      <a href="/works/new" class="btn">Create Work</a>
    </div>

    <p class="text-slate-300 mb-6">
      Search locally stored Works. A Work is the intellectual creation shared by
      its Editions, and it can exist with only a title. Open Library suggestions
      appear when the provider is available; accepting a suggestion stores it in
      PageTurn.
    </p>

    <form method="GET" action="/works" class="mb-8 max-w-xl">
      <label for="q" class="form-label">Search Works</label>
      <div class="flex gap-3">
        <input
          type="search"
          id="q"
          name="q"
          value={query}
          placeholder="Search by title"
          class="form-input"
        />
        <button type="submit" class="btn">Search</button>
      </div>
    </form>

    {
      acceptError && (
        <div
          class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4"
          role="alert"
        >
          <p>{acceptError}</p>
        </div>
      )
    }

    {
      providerError && query && (
        <p data-field="provider-error" class="text-amber-300 mb-6">
          Open Library is unavailable. Local catalog search still works.
        </p>
      )
    }

    {
      suggestions.length > 0 && (
        <section class="mb-10" data-field="suggestions">
          <h2>Open Library suggestions</h2>
          <p class="text-slate-400 text-sm mb-4">
            Search does not save these. Accept a suggestion to store it in
            PageTurn.
          </p>
          <ul class="space-y-3">
            {suggestions.map((suggestion) => (
              <li class="card" data-work-key={suggestion.workKey}>
                <p data-field="suggestion-title">{suggestion.title}</p>
                {suggestion.authors.length > 0 && (
                  <p class="text-slate-400 text-sm">{suggestion.authors.join(', ')}</p>
                )}
                <form method="POST" class="mt-3">
                  <input
                    type="hidden"
                    name="suggestion"
                    value={JSON.stringify(suggestion)}
                  />
                  <button type="submit" class="btn">
                    Accept into catalog
                  </button>
                </form>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      works.length === 0 ? (
        <div class="card text-center py-12">
          <h2>No Works found</h2>
          <p class="mb-6">
            {query
              ? 'No locally stored Works match that title.'
              : 'The catalog is empty. Create a Work from a title to get started.'}
          </p>
          <a href="/works/new" class="btn">
            Create Work
          </a>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full whitespace-nowrap">
            <thead>
              <tr class="bg-gray-100 dark:bg-slate-700">
                <th class="px-4 py-3 text-left">Title</th>
                <th class="px-4 py-3 text-left">First publication date</th>
                <th class="px-4 py-3 text-left">Subjects</th>
              </tr>
            </thead>
            <tbody>
              {works.map((work) => (
                <tr class="border-b border-slate-700 hover:bg-slate-800/50">
                  <td class="px-4 py-3">
                    <a href={`/works/${work.id}`}>{work.title}</a>
                  </td>
                  <td class="px-4 py-3 text-slate-400">
                    {work.firstPublicationDate ?? 'Unknown'}
                  </td>
                  <td class="px-4 py-3 text-slate-400" data-field="subjects">
                    {work.subjects.length === 0
                      ? 'None'
                      : work.subjects.map((subject) => subject.name).join(', ')}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    <p class="text-slate-500 text-sm mt-10" data-field="open-library-attribution">
      Catalog suggestions include
      <a href="https://openlibrary.org">Open Library</a> data, used under their
      terms. PageTurn stores accepted records locally.
    </p>
  </div>
</Layout>
