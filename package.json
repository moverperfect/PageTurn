{
  "name": "page-turn",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.10.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro build && astro preview",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:migrations": "vitest run --project migrations",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply page-turn --local",
    "db:migrate:prod": "wrangler d1 migrations apply page-turn --remote",
    "db:migrate:preview": "wrangler d1 migrations apply --env preview page-turn --remote"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.1.7",
    "@libsql/client": "0.17.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/uuid": "11.0.0",
    "astro": "7.3.8",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.6",
    "better-sqlite3": "13.0.3",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  }
}
